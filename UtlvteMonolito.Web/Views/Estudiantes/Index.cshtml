@model IEnumerable<UtlvteMonolito.Web.Models.Estudiante>
@{
    ViewData["Title"] = "Gestión de Estudiantes - UTLVTE";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Listado de Estudiantes Registrados</h2>
        <a asp-action="Crear" class="btn btn-primary">+ Registrar Nuevo Estudiante</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Cédula</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Correo Institucional</th>
                <th>Carrera</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Cedula</td>
                    <td>@item.Nombres</td>
                    <td>@item.Apellidos</td>
                    <td>@item.CorreoInstitucional</td>
                    <td>@item.Carrera</td>
                    <td>
                        <span class="badge @(item.EstadoActivo ? "bg-success" : "bg-danger")">
                            @(item.EstadoActivo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>